// Helper component for rendering different field types
function renderFieldInput(
  field: ServiceField,
  register: any,
  handleFieldChange: (fieldName: string, value: any) => void,
  currentValue: any
) {
  switch (field.field_type) {
    case 'text':
      return (
        <Input
          {...register(field.name)}
          value={currentValue}
          onChange={(e) => handleFieldChange(field.name, e.target.value)}
          placeholder={`Enter ${field.label.toLowerCase()}`}
          required={field.is_required}
        />
      );
    case 'textarea':
      return (
        <Textarea
          {...register(field.name)}
          value={currentValue}
          onChange={(e) => handleFieldChange(field.name, e.target.value)}
          placeholder={`Enter ${field.label.toLowerCase()}`}
          required={field.is_required}
          className="h-16"
        />
      );
    case 'number':
      return (
        <Input
          type="number"
          {...register(field.name)}
          value={currentValue}
          onChange={(e) => handleFieldChange(field.name, e.target.value === '' ? '' : Number(e.target.value))}
          placeholder={`Enter ${field.label.toLowerCase()}`}
          required={field.is_required}
        />
      );
    case 'date':
      return (
        <Input
          type="date"
          {...register(field.name)}
          value={currentValue}
          onChange={(e) => handleFieldChange(field.name, e.target.value)}
          required={field.is_required}
        />
      );
    case 'select':
      return (
        <Select>
          <SelectTrigger
            {...register(field.name)}
            value={currentValue}
            onValueChange={(value) => handleFieldChange(field.name, value)}
          >
            <SelectValue placeholder={`Select ${field.label.toLowerCase()}`} />
            <SelectContent>
              {field.options?.map((option) => (
                <SelectItem key={option} value={option}>
                  {option}
                </SelectItem>
              )) || []}
            </SelectContent>
          </SelectTrigger>
          <SelectLabel>{field.label}</SelectLabel>
          {field.is_required && <SelectItem disabled>This field is required</SelectItem>}
        </Select>
      );
    case 'boolean':
      return (
        <div className="flex items-center gap-2">
          <input
            type="checkbox"
            {...register(field.name)}
            checked={!!currentValue}
            onChange={(e) => handleFieldChange(field.name, e.target.checked)}
          />
          <span>{field.label}</span>
        </div>
      );
    default:
      return (
        <Input
          {...register(field.name)}
          value={currentValue}
          onChange={(e) => handleFieldChange(field.name, e.target.value)}
          placeholder={`Enter ${field.label.toLowerCase()}`}
          required={field.is_required}
        />
      );
  }
}

// Help tooltip component
function HelpTooltip({ helpText, className }: { helpText: string; className?: string }) {
  if (!helpText) return null;

  return (
    <div className="relative inline-block">
      <div className={className}>ⓘ</div>
      <div className="absolute left-0 top-8 w-48 rounded-md border bg-popover p-2 text-sm text-popover-foreground shadow-lg z-50">
        <p className="mb-0">{helpText}</p>
      </div>
    </div>
  );
}

