def platform_permissions_for(role: PlatformRole | None) -> frozenset[str]:
    """Return the platform permissions granted to a platform role (empty if none)."""
    if role is None:
        return frozenset()
    return PLATFORM_ROLE_PERMISSIONS.get(role, frozenset())


def shop_permissions_for(role: ShopRole | None) -> frozenset[str]:
    """Return the shop permissions granted to a shop role (empty if none)."""
    if role is None:
        return frozenset()
    return SHOP_ROLE_PERMISSIONS.get(role, frozenset())


def platform_role_hierarchy() -> tuple[PlatformRole, ...]:
    """Order of platform roles from most to least privileged (for documentation)."""
    return (
        PlatformRole.OWNER,
        PlatformRole.ADMIN,
        PlatformRole.MANAGER,
        PlatformRole.FINANCIAL_MANAGER,
        PlatformRole.SUPPORT,
    )


def shop_role_hierarchy() -> tuple[ShopRole, ...]:
    """Order of shop roles from most to least privileged (for documentation)."""
    return (
        ShopRole.OWNER,
        ShopRole.MANAGER,
        ShopRole.STAFF,
        ShopRole.FINANCIAL_STAFF,
    )
