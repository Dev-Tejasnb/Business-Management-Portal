# =============================================================================
# Business Management Portal - Environment Configuration (example)
#
# Copy this file to `.env` and adjust values for your local environment.
# NEVER commit the real `.env` file.
# =============================================================================

# ---- Application ------------------------------------------------------------
APP_ENV=development
APP_NAME=Business Management Portal
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1

# ---- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false

# ---- Security ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-generate-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- Platform Owner Bootstrap (development only) ----------------------------
BOOTSTRAP_PLATFORM_OWNER_EMAIL=owner@example.com
BOOTSTRAP_PLATFORM_OWNER_PASSWORD=ChangeMe123!
BOOTSTRAP_PLATFORM_OWNER_NAME=Initial Platform Owner

# ---- Database (PostgreSQL) ---------------------------------------------------
POSTGRES_DB=bmp
POSTGRES_USER=bmp_user
POSTGRES_PASSWORD=change-me-db-password
DATABASE_URL=postgresql+asyncpg://bmp_user:change-me-db-password@postgres:5432/bmp

# ---- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# ---- MinIO (object storage) --------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET=bmp-documents
MINIO_SECURE=false

# ---- CORS -------------------------------------------------------------------
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# ---- Frontend ----------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
BACKEND_INTERNAL_URL=http://backend:8000/api/v1