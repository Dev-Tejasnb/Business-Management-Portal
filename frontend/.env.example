# Frontend environment variables (example)
# Copy to `.env.local` for local development outside Docker.

# Base URL of the backend API, used by the client (browser).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Internal backend URL, used by Next.js server-side code / API routes.
BACKEND_INTERNAL_URL=http://backend:8000/api/v1