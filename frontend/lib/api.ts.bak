898	function buildDateRangeParams(params: DateRangeRequest): URLSearchParams {
899	  const searchParams = new URLSearchParams();
900	  searchParams.set("preset", params.preset);
901	  if (params.from_date) searchParams.set("from_date", params.from_date);
902	  if (params.to_date) searchParams.set("to_date", params.to_date);
903	  return searchParams;
904	}
